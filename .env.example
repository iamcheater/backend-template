# App configuration
PORT=3060
NODE_ENV=local

# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=backend

# Admin auth configuration
ADMIN_JWT_SECRET=change-me
ADMIN_JWT_EXPIRES_IN=14d

# Super Admin configuration
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# HTTP configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=0
INTERNAL_API_KEY=

# Telegram configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Languages (comma-separated subset of hy,en,ru; the default must be in the list)
SUPPORTED_LANGUAGES=hy,en,ru
DEFAULT_LANGUAGE=en

# Client configuration
ADMIN_DASHBOARD_URL=http://localhost:3001

# Website revalidation (secret: 32+ characters, same value as on the website)
WEBSITE_URL=http://localhost:3000
WEBSITE_REVALIDATE_SECRET=

# AWS S3 configuration
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public media base URL (defaults to https://<AWS_S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com)
MEDIA_PUBLIC_BASE_URL=

# Media upload size limits (MB)
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_VIDEO_CHUNK_SIZE_MB=10
